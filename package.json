{
  "name": "agent-company",
  "version": "0.2.0",
  "description": "A multi-agent orchestration framework that organizes AI agents as functional business teams — with built-in evaluation and benchmarks.",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "agent-framework",
    "orchestration",
    "llm",
    "evaluation",
    "benchmark"
  ],
  "author": "Joshua Hidary",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshuaHidary/agent-company.git"
  },
  "bugs": {
    "url": "https://github.com/JoshuaHidary/agent-company/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --import tsx --test src/*.test.ts src/eval/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --import tsx src/demo.ts",
    "eval": "node --import tsx src/eval/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}
